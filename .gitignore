# Project-local script output: releases, caches, reports and private backups
.artifacts/
# IIS deployment output
/deloy/
# Local publishing credentials (included only in generated Production configuration)
/server_dotnet/deploy/publish-defaults.local.json
# Legacy runtime directories remain ignored for older local commands
.runlogs/
.acceptance-backups/
.repair-backups/
.playwright-cli/

# Frontend dependencies and builds
/node_modules/
web/node_modules/
web/dist/
web/dist-ssr/
web/output/
web/.playwright-cli/
web/*.log
web/*.local

# Generated local test artifacts
e2e_chunk_*.zip
e2e_resume_*.zip
e2e_invalid_*.exe
real_test.pdf
real_test.xlsx
*_legacy_backup_*.sql

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# User-supplied full source archive; the required Excel runtime is vendored separately.
/third_party/vue-office-source-2024-12-30/
/web/generated/
/web/.excel-preview-build/
/web/.pptx-preview-build/

# Claude Code runtime state
.claude/scheduled_tasks.lock
