{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "pretest": "npm run build:excel-preview && npm run build:pptx-preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/precompress-assets.mjs",
    "test:precompression": "node --test scripts/precompress-assets.test.mjs",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "build:excel-preview": "node scripts/build-excel-preview.mjs",
    "predev": "npm run build:excel-preview && npm run build:pptx-preview",
    "prebuild": "npm run build:excel-preview && npm run build:pptx-preview",
    "build:pptx-preview": "node scripts/build-pptx-preview.mjs",
    "generate:api-types": "node scripts/generate-api-types.mjs"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.16",
    "@microsoft/signalr": "10.0.11",
    "@tanstack/react-query": "5.103.2",
    "axios": "^1.20.0",
    "dayjs": "1.11.23",
    "exceljs": "4.4.0",
    "lodash": "4.18.1",
    "pdfjs-dist": "6.3.289",
    "pptx-preview": "0.0.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "spark-md5": "3.0.2",
    "tinycolor2": "1.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/spark-md5": "3.0.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "30.1.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "5.0.1"
  },
  "yfDependencyPolicy": {
    "bundledPreviewRuntimeDependencies": ["dayjs", "exceljs", "lodash", "pptx-preview", "tinycolor2", "xlsx"],
    "reason": "These packages are imported by the vendored Excel/PPTX viewer sources and bundled into production preview assets."
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "pptx-preview": {
      "uuid": "11.1.1"
    }
  }
}
